__pycache__/
*.pyc
.pytest_cache/
*.bak
.DS_Store
# Clips are downloaded, never committed; the hand labels are the opposite.
# git will not descend into an ignored directory, so the clips are excluded
# entry by entry rather than by ignoring footage/ wholesale.
footage/*
!footage/groundtruth/
footage/groundtruth/*
!footage/groundtruth/*.json
*.egg-info/
.commandcode
.venv/
# Rendered reports (tools/queue_report.py writes video here).
out/

# Source recordings dropped into the planning dir. Same rule as footage/:
# SHARED.md §8 keeps clips out of git and downloads them instead.
.mrkr/*.mp4
.mrkr/*.mov
